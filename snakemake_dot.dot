digraph snakemake_dag {
    graph [bgcolor=transparent, margin=0.2, splines=ortho, rankdir=TB, nodesep=0.4, ranksep=0.5, size="8.27,11.69", dpi=300, fontname="Helvetica"];
    node [shape=box, style="rounded,filled", fillcolor=white, fontname="Helvetica", fontsize=9, penwidth=1.2, color="#333333", margin="0.05,0.05"];
    edge [penwidth=1.5];

    // --- MÓDULO 1 ---
    subgraph cluster_1 {
        label = "1. Raw Data & Pre-Processing"; style="filled,rounded"; fillcolor="#f8f9fa"; color="#ced4da"; fontname="Helvetica-Bold";
        1 [label="download_sra_data_paired", fillcolor="#495057", fontcolor=white];
        3 [label="fastp_paired"];
    }

    // --- MÓDULO 2 (ECOLOGICAL - VERDE) ---
    subgraph cluster_2 {
        label = "2. Ecological Approach (Direct Reads)"; style="filled,rounded"; fillcolor="#e8f5e9"; color="#a5d6a7"; fontname="Helvetica-Bold";
        node [fillcolor="#c8e6c9", color="#4caf50"];
        17 [label="diamond_blastx_reads"];
        21 [label="kraken2_reads_paired"];
        37 [label="get_megan6_mapper", shape=cylinder, fillcolor="#ffe082", color="#f57f17"];
        36 [label="reads_diamond_daa"];
        35 [label="reads_meganizer"];
        34 [label="reads_daa2info", shape=note, penwidth=2];
        20 [label="kraken_biom_reads"];
        22 [label="krona_reads_kraken", shape=note];
        24 [label="kraken_biom_merge_all"];
        23 [label="kraken_rarefaction_plot", shape=note];
        32 [label="generate_diamond_reads_stats", fillcolor="#fafafa", color="#9e9e9e"];
        33 [label="generate_kraken2_reads_stats", fillcolor="#fafafa", color="#9e9e9e"];
    }

    // --- MÓDULO 3 (ASSEMBLY - AZUL) ---
    subgraph cluster_3 {
        label = "3. Assembly & Taxonomic Assignment"; style="filled,rounded"; fillcolor="#e3f2fd"; color="#90caf9"; fontname="Helvetica-Bold";
        node [fillcolor="#bbdefb", color="#2196f3"];
        2 [label="spades", fillcolor="#1565c0", fontcolor=white];
        26 [label="kraken2_contigs"];
        8 [label="diamond_blastx_contigs"];
        9 [label="filter_contigs_diamond"];
        10 [label="download_prot", shape=cylinder, fillcolor="#ffe082", color="#f57f17"];
        7 [label="map_accession_to_taxid", fillcolor="#ffecb3", color="#ffb300"];
        5 [label="append_lineage", fillcolor="#ffecb3", color="#ffb300"];
        19 [label="krona_update_taxonomy", shape=cylinder, fillcolor="#ffe082", color="#f57f17"];
        18 [label="krona_diamond", shape=note, penwidth=2, fillcolor="#ffecb3", color="#ffb300"];
        27 [label="krona_kraken2", shape=note, penwidth=2];
        30 [label="generate_assembly_stats", fillcolor="#fafafa", color="#9e9e9e"];
        28 [label="generate_kraken2_stats", fillcolor="#fafafa", color="#9e9e9e"];
        29 [label="generate_diamond_stats", fillcolor="#fafafa", color="#9e9e9e"];
        25 [label="kraken_biom_contig"];
    }

    // --- MÓDULO 4 (DARK MATTER - ROSA) ---
    subgraph cluster_4 {
        label = "4. Viral Dark Matter Exploration"; style="filled,rounded"; fillcolor="#fce4ec"; color="#f48fb1"; fontname="Helvetica-Bold";
        node [fillcolor="#fce4ec", color="#c2185b"];
        15 [label="get_nohit_fasta", fontcolor=white];
        14 [label="find_orfs"];
        13 [label="cd_hit"];
        12 [label="palm_annot"];
        11 [label="fev2tsv_single"];
        16 [label="dm_validate", shape=note, penwidth=2];
        31 [label="generate_darkmatter_stats", fillcolor="#fafafa", color="#9e9e9e"];
    }

    // --- FINAL ---
    4 [label="report_summarize", shape=note, penwidth=3, fillcolor="#8e24aa", fontcolor=white, color="#4a148c"];
    0 [label="Pipeline End", style="rounded,filled", fillcolor="#343a40", fontcolor=white];

    // ==========================================
    // CONEXÕES COM CORES POR MÓDULO
    // ==========================================
    1 -> 3 [color="#6c757d"]; 3 -> 17 [color="#6c757d"]; 3 -> 21 [color="#6c757d"]; 3 -> 36 [color="#6c757d"]; 3 -> 2 [color="#6c757d"];
    
    // Green Edges
    37 -> 35 -> 34 [color="#4caf50"]; 36 -> 35 [color="#4caf50"];
    21 -> 20 -> 24 -> 23 [color="#4caf50"]; 21 -> 22 [color="#4caf50"]; 21 -> 33 [color="#4caf50"]; 17 -> 32 [color="#4caf50"];
    
    // Blue/Orange Edges
    2 -> 8 -> 7 -> 5 [color="#2196f3"]; 2 -> 30 [color="#2196f3"]; 2 -> 26 [color="#2196f3"]; 8 -> 29 [color="#2196f3"];
    26 -> 25 [color="#2196f3"]; 26 -> 27 [color="#2196f3"]; 26 -> 28 [color="#2196f3"];
    10 -> 7 [color="#ffb300"]; 5 -> 18 [color="#ffb300"]; 19 -> 18 [color="#ffb300"];
    
    // Pink Edges
    5 -> 15 [color="#c2185b"]; 15 -> 14 -> 13 -> 12 -> 11 -> 16 [color="#c2185b"]; 15 -> 31 [color="#c2185b"];
    
    // Final
    5 -> 4 [color="#8e24aa"]; 11 -> 4 [color="#8e24aa"]; 2 -> 4 [color="#8e24aa"];
    34->0; 23->0; 22->0; 32->0; 33->0; 20->0; 30->0; 29->0; 28->0; 25->0; 27->0; 18->0; 16->0; 31->0; 4->0;
}
