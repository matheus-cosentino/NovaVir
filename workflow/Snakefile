    SAMPLE = [line.strip() for line in file if line.strip()]

SAMPLE_META = identify_data_type(SAMPLE, DATA)

############################################
# --- 4. Export functions to be used.  --- #
###########################################
import scripts.functions as functions

if isinstance(config["modules"], str):
    try:
        config["modules"] = ast.literal_eval(config["modules"])
    except (ValueError, SyntaxError):
        print("[ERROR] Could not parse 'modules' configuration string.")
        raise

functions.DATA = DATA
functions.SAMPLE = SAMPLE
functions.OUT_DIR = OUT_DIR
functions.SAMPLE_META = SAMPLE_META
functions.MAPPER = config["tool"]["denovo"] 
functions.MODULES = config["modules"]
