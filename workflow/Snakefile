# --- 8. Obtain the final target & Download Data cleanup --- #
##############################################################
rule all:
    input: 
        expand(os.path.join(OUT_DIR, "{sample}", "reporting", "{sample}_reporting.html"), sample=SAMPLE)

onsuccess:
    cleanup_downloaded_fastqs()
    print("Workflow finished successfully!")

onerror:
    print("Workflow failed. Temporary files were NOT removed to aid debugging.")